---
import type { Language } from '../lib/types';

export interface Props {
  lang: Language;
}

const { lang = 'hi' } = Astro.props;
---

<div id="transliterate-container" data-lang={lang}>
  <input type="text" id="transliterate-input" />
  <ul id="suggestions-list" class="suggestion-list"></ul>
</div>

<style>
  #transliterate-container {
    position: relative;
  }

  .suggestion-list {
    background-clip: padding-box;
    background-color: #fff;
    border: 1px solid rgba(0, 0, 0, 0.15);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.175);
    display: block;
    font-size: 14px;
    list-style: none;
    padding: 1px;
    text-align: left;
    z-index: 20000;
    position: absolute;
    width: auto;
    min-width: 100px;
  }

  .suggestion-list > li {
    cursor: pointer;
    padding: 10px;
  }

  .suggestion-list > li.active {
    background-color: #65c3d7;
    color: #fff;
  }
</style>

<script is:inline>
  const container = document.getElementById('transliterate-container');
  const input = document.getElementById('transliterate-input');
  const suggestionsList = document.getElementById('suggestions-list');
  const lang = container.dataset.lang;

  let matchStart = -1;
  let selection = 0;

  function setCaretPosition(elem, caretPos) {
    if (elem) {
      if (elem.selectionStart) {
        elem.focus();
        elem.setSelectionRange(caretPos, caretPos);
      } else {
        elem.focus();
      }
    }
  }

  function getInputSelection(el) {
    const start = 0;
    const end = 0;

    if (!el) {
      return { start, end };
    }

    if (
      typeof el.selectionStart === "number" &&
      typeof el.selectionEnd === "number"
    ) {
      return { start: el.selectionStart, end: el.selectionEnd };
    }

    return { start, end };
  }

  function updateSelection() {
    if (suggestionsList) {
      const items = suggestionsList.querySelectorAll('li');
      items.forEach((item, index) => {
        if (index === selection) {
          item.classList.add('active');
        } else {
          item.classList.remove('active');
        }
      });
    }
  }

  input.addEventListener('input', async (e) => {
    const value = e.target.value;
    const caret = getInputSelection(e.target).end;
    const indexOfLastSpace = value.lastIndexOf(' ', caret - 1);
    matchStart = indexOfLastSpace + 1;
    const currentWord = value.slice(indexOfLastSpace + 1, caret);

    if (currentWord && suggestionsList) {
      const response = await fetch(`https://inputtools.google.com/request?text=${currentWord}&itc=${lang}-t-i0-und&num=5&cp=0&cs=1&ie=utf-8&oe=utf-8&app=demopage`);
      const data = await response.json();

      if (data && data[0] === 'SUCCESS') {
        const suggestions = data[1][0][1];
        suggestionsList.innerHTML = '';
        selection = 0;
        suggestions.forEach((suggestion, index) => {
          const li = document.createElement('li');
          li.textContent = suggestion;
          li.addEventListener('click', () => {
            const newValue =
              value.substring(0, matchStart) +
              suggestion +
              ' ' +
              value.substring(caret, value.length);
            input.value = newValue;
            suggestionsList.innerHTML = '';
            input.focus();
            setCaretPosition(input, matchStart + suggestion.length + 1);
          });
          li.addEventListener('mouseenter', () => {
            selection = index;
            updateSelection();
          });
          suggestionsList.appendChild(li);
        });
        updateSelection();
      }
    } else if (suggestionsList) {
      suggestionsList.innerHTML = '';
    }
  });

  input.addEventListener('keydown', (e) => {
    if (suggestionsList && suggestionsList.children.length > 0) {
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        selection = (selection - 1 + suggestionsList.children.length) % suggestionsList.children.length;
        updateSelection();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        selection = (selection + 1) % suggestionsList.children.length;
        updateSelection();
      } else if (e.key === 'Enter' || e.key === 'Tab') {
        e.preventDefault();
        const selectedSuggestion = suggestionsList.children[selection];
        selectedSuggestion.click();
      } else if (e.key === 'Escape') {
        e.preventDefault();
        if (suggestionsList) {
          suggestionsList.innerHTML = '';
        }
      }
    }
  });

  document.addEventListener('click', (e) => {
    if (container && !container.contains(e.target) && suggestionsList) {
      suggestionsList.innerHTML = '';
    }
  });
</script>
